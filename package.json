{
  "name": "video-editor",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local AI video editor for creators: drop in clips, describe the edit, and your own Claude Code cuts, captions, designs and exports it on your PC.",
  "repository": { "type": "git", "url": "https://github.com/haidermoulay3mk/local-ai-video-editor.git" },
